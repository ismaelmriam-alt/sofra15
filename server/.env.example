# Local backend environment. Set production values in the backend host's secret settings.
NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/sofra

# Comma-separated exact browser origins (no trailing slashes). Add the deployed Vercel origin on the backend host.
CLIENT_ORIGINS=http://localhost:5173

# Use a long, unique value locally; set a separate secret in production.
ADMIN_PASSWORD=sofra2026

# Optional for local work; required on the backend host for admin image uploads.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
